@PACKAGE_INIT@

# MeshMS links OpenMP PUBLIC-ly when it was built with OpenMP, so the exported
# target carries an OpenMP::OpenMP_CXX usage requirement. Re-find it here (only
# when that was the case) before importing the targets.
if(@MESHMS_OPENMP_PUBLIC@)
  include(CMakeFindDependencyMacro)
  find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MeshMSTargets.cmake")

check_required_components(MeshMS)
